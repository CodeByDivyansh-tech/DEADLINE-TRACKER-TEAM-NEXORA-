# Copy this file to .env (same folder as server.js) and fill in your values.
# .env is private: it's in .gitignore and the server never sends it to the browser.

# --- Google Gemini (free tier) for Deadline AI Help ---
# Get a free key at https://aistudio.google.com/apikey (no card needed for the free tier).
# Leave empty to run without AI: Help then answers straight from the help guide.
GEMINI_API_KEY=
# Free-tier models (checked Nov 2026 on Google's pricing page). Change only if Google retires them.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768
# Our own limits, kept below Google's free-tier limits (requests per minute / per day, per user per day).
GEMINI_RPM=8
GEMINI_RPD=400
AI_USER_DAILY=40

# --- Server ---
PORT=8000
# 127.0.0.1 = only this computer. Use 0.0.0.0 on a server (set automatically when NODE_ENV=production).
HOST=127.0.0.1
# Where the database file lives (default: ./data). On a host, point this at a persistent disk.
DATA_DIR=./data
# Optional: permanent copy of the database in Neon Postgres (free). Needed on hosts that wipe the disk on restart,
# like Render's free plan. Paste the connection string from Neon (postgresql://...). Leave empty on your laptop.
DATABASE_URL=
# How often to check for changes to save to Neon (milliseconds).
PERSIST_INTERVAL_MS=3000
# If Neon can't be used at start, wait this long, then start anyway WITHOUT saving to Neon (the reason shows in
# /api/health), and check again every PERSIST_RECHECK_MS. Saved data in Neon is never overwritten.
PERSIST_START_TIMEOUT_MS=60000
PERSIST_RECHECK_MS=30000
# Optional: "Forgot password?" emails. Free with Brevo (300 emails/day; verify one sender address, no domain needed)
# or Resend. Without these, the site says reset emails aren't set up and an admin can make a reset link instead.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=Deadline Tracker <you@example.com>
# The address people use to open the site (for links in emails), e.g. https://deadline-tracker-team-nexora.vercel.app
PUBLIC_URL=
# How long a reset link works (minutes).
RESET_TOKEN_MINUTES=30
# production: cookies need HTTPS, server listens on all interfaces.
NODE_ENV=development
# true when running behind a proxy/load balancer that sets X-Forwarded-For (Render, Railway, Nginx).
TRUST_PROXY=false
# Optional: this email becomes an admin when it signs up (the first account is always an admin).
ADMIN_EMAIL=
# How often the reminder job runs (milliseconds).
REMINDER_INTERVAL_MS=60000
# Requests per minute allowed from one IP address to the API.
API_RPM=600
